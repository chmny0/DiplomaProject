<Window x:Class="WpfPlannerApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Календарь"
        WindowStartupLocation="CenterScreen"
        MinWidth="900"
        MinHeight="650">

    <Grid Background="{StaticResource BgBrush}">

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="60"/>
            <ColumnDefinition Width="0" x:Name="SidebarColumn"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Левая икон-панель -->
        <Border Grid.Column="0"
                Background="{StaticResource PrimaryBrush}">

            <StackPanel Margin="0,20">
                <Button Content="☰"
                        Height="50"
                        Background="Transparent"
                        Foreground="White"
                        BorderThickness="0"
                        FontSize="20"
                        Click="ToggleSidebar_Click"/>

                <Button Content="➕"
                        Height="50"
                        Background="Transparent"
                        Foreground="White"
                        BorderThickness="0"
                        FontSize="20"
                        Click="AddAppointment_Click"/>
            </StackPanel>
        </Border>

        <!-- Sidebar -->
        <Border x:Name="Sidebar"
        Grid.Column="1"
        Background="{StaticResource CardBrush}"
        Padding="20">

            <StackPanel>
                <TextBlock Text="Пользователь"
                   FontSize="20"
                   FontWeight="SemiBold"
                   Foreground="{StaticResource PrimaryBrush}"/>

                <TextBlock x:Name="UserNameText"
                   Margin="0,10,0,20"
                   Foreground="{StaticResource MutedTextBrush}"/>

                <Button Content="Выйти"
                Background="{StaticResource AccentBrush}"
                Click="Logout_Click"/>

                <!-- ВОТ ТУТ БЫЛО БЕЗ x:Name -->
                <Button x:Name="AddWorkerButton"
                Content="➕ Добавить сотрудника"
                Background="{StaticResource PrimaryBrush}"
                Click="AddWorker_Click"/>
            </StackPanel>
        </Border>
 

        <!-- Основная карточка -->
        <Border Grid.Column="2"
                Style="{StaticResource CardStyle}">

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="0,0,0,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Button Content="❮" Width="36" Height="36" Click="PrevMonth_Click"/>

                    <TextBlock x:Name="MonthText"
                               Grid.Column="1"
                               FontSize="24"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource PrimaryBrush}"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>

                    <Button Content="❯" Grid.Column="2" Width="36" Height="36" Click="NextMonth_Click"/>
                </Grid>

                <UniformGrid x:Name="CalendarGrid"
                             Grid.Row="1"
                             Rows="6"
                             Columns="7"/>
            </Grid>
        </Border>

    </Grid>
</Window>
