<Window x:Class="WpfPlannerApp.Windows.WorkerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Мои выезды"
        Width="900"
        Height="600"
        WindowStartupLocation="CenterScreen">

    <!-- Используем фон из ресурсов -->
    <Grid Background="{StaticResource BgBrush}">

        <!-- Карточка с использованием CardStyle -->
        <Border Style="{StaticResource CardStyle}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Заголовок -->
                <StackPanel Margin="0,0,0,15">
                    <TextBlock Text="Мои выезды"
                               FontSize="26"
                               FontWeight="SemiBold"
                               FontFamily="Segoe UI Variable"
                               Foreground="{StaticResource PrimaryBrush}"/>
                    <TextBlock x:Name="WorkerNameText"
                               FontSize="14"
                               Foreground="{StaticResource MutedTextBrush}"/>
                </StackPanel>

                <!-- Таблица -->
                <DataGrid x:Name="AppointmentsGrid"
                          Grid.Row="1"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          HeadersVisibility="Column"
                          GridLinesVisibility="None"
                          RowHeight="42"
                          Background="Transparent"
                          BorderThickness="0"
                          SelectionMode="Single"
                          VerticalScrollBarVisibility="Auto">

                    <!-- Заголовки колонок -->
                    <DataGrid.ColumnHeaderStyle>
                        <Style TargetType="DataGridColumnHeader">
                            <Setter Property="Height" Value="44"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                            <Setter Property="Foreground" Value="{StaticResource PrimaryBrush}"/>
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="BorderThickness" Value="0"/>
                            <Setter Property="Padding" Value="12,8"/>
                            <Setter Property="HorizontalContentAlignment" Value="Left"/>
                        </Style>
                    </DataGrid.ColumnHeaderStyle>

                    <!-- Стиль строк -->
                    <DataGrid.RowStyle>
                        <Style TargetType="DataGridRow">
                            <Setter Property="Background" Value="{StaticResource CardBrush}"/>
                            <Setter Property="Height" Value="42"/>
                            <Setter Property="BorderThickness" Value="0"/>
                            <Setter Property="SnapsToDevicePixels" Value="True"/>
                            <Setter Property="VerticalContentAlignment" Value="Center"/>

                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#F7F6FB"/>
                                </Trigger>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter Property="Background" Value="#E6E1F5"/>
                                    <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </DataGrid.RowStyle>

                    <!-- Стиль ячеек -->
                    <DataGrid.CellStyle>
                        <Style TargetType="DataGridCell">
                            <Setter Property="Padding" Value="12,8"/>
                            <Setter Property="BorderThickness" Value="0"/>
                            <Setter Property="VerticalAlignment" Value="Center"/>
                            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="DataGridCell">
                                        <Grid Background="{TemplateBinding Background}">
                                            <ContentPresenter VerticalAlignment="Center"
                                                              Margin="{TemplateBinding Padding}"/>
                                        </Grid>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </DataGrid.CellStyle>

                    <!-- Колонки -->
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Дата"
                                            Binding="{Binding Date}"
                                            Width="120"
                                            Foreground="{StaticResource TextBrush}"/>
                        <DataGridTextColumn Header="Время"
                                            Binding="{Binding Time}"
                                            Width="90"
                                            Foreground="{StaticResource TextBrush}"/>
                        <DataGridTextColumn Header="Адрес"
                                            Binding="{Binding Address}"
                                            Width="*"
                                            MinWidth="200"
                                            Foreground="{StaticResource TextBrush}"/>
                        <DataGridTextColumn Header="Тип работ"
                                            Binding="{Binding WorkType}"
                                            Width="180"
                                            Foreground="{StaticResource TextBrush}"/>
                        <DataGridTextColumn Header="Статус"
                                            Binding="{Binding Status}"
                                            Width="130"
                                            Foreground="{StaticResource TextBrush}"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>
    </Grid>
</Window>