<Window x:Class="WpfPlannerApp.Windows.AdminWorkersWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Сотрудники"
        Width="900" Height="600"
        WindowStartupLocation="CenterScreen">

    <Grid Margin="15">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="320"/>
        </Grid.ColumnDefinitions>

        <!-- ТАБЛИЦА -->
        <DataGrid x:Name="WorkersGrid"
                  AutoGenerateColumns="False"
                  SelectionMode="Single"
                  IsReadOnly="True"
                  SelectionChanged="WorkersGrid_SelectionChanged">

            <DataGrid.Columns>
                <DataGridTextColumn Header="ID" Binding="{Binding UserId}" Width="60"/>
                <DataGridTextColumn Header="Логин" Binding="{Binding Username}" Width="120"/>
                <DataGridTextColumn Header="ФИО" Binding="{Binding FullName}" Width="*"/>
                <DataGridTextColumn Header="Роль" Binding="{Binding Role}" Width="100"/>
                <DataGridCheckBoxColumn Header="Активен" Binding="{Binding IsActive}" Width="80"/>
            </DataGrid.Columns>
        </DataGrid>

        <!-- ФОРМА -->
        <StackPanel Grid.Column="1" Margin="15">

            <TextBlock Text="Данные сотрудника"
                       FontSize="18" FontWeight="SemiBold" Margin="0,0,0,10"/>

            <TextBlock Text="Логин"/>
            <TextBox x:Name="LoginBox"/>

            <TextBlock Text="ФИО" Margin="0,10,0,0"/>
            <TextBox x:Name="NameBox"/>

            <TextBlock Text="Пароль (если нужно изменить)" Margin="0,10,0,0"/>
            <PasswordBox x:Name="PasswordBox"/>

            <CheckBox x:Name="ActiveBox" Content="Активен" Margin="0,10,0,0"/>

            <StackPanel Orientation="Horizontal" Margin="0,20,0,0">
                <Button Content="Новый" Width="70" Click="New_Click"/>
                <Button Content="Сохранить" Width="95" Margin="10,0" Click="Save_Click"/>
                <Button Content="Удалить" Width="70" Click="Delete_Click"/>
            </StackPanel>

        </StackPanel>
    </Grid>
</Window>
