<Window x:Class="WpfPlannerApp.Windows.AdminWorkersWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Сотрудники"
        Width="1000"
        Height="650"
        MinWidth="900"
        MinHeight="550"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BackgroundBrush}">

    <Window.Resources>
        <Style x:Key="FilterButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="32"/>
            <Setter Property="Padding" Value="16,0"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Normal"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource SecondaryTextBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="20" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#EDE7F6"/>
                    <Setter Property="BorderBrush" Value="{StaticResource PrimaryBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="ActiveFilterButtonStyle" TargetType="Button" BasedOn="{StaticResource FilterButtonStyle}">
            <Setter Property="Background" Value="{StaticResource PrimaryBrush}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="{StaticResource PrimaryBrush}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
    </Window.Resources>
    <Grid Margin="20">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="340"/>
        </Grid.ColumnDefinitions>
        <Border Grid.Column="0" Style="{StaticResource Card}" Margin="0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <TextBlock Text="👥 Сотрудники" FontSize="20" FontWeight="SemiBold" Foreground="{StaticResource PrimaryBrush}" Margin="0,0,0,15"/>
                <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,15">
                    <Button x:Name="FilterAll" Content="Все" Style="{StaticResource ActiveFilterButtonStyle}" Click="Filter_Click"/>
                    <Button x:Name="FilterWorking" Content="🟢 Работающие" Style="{StaticResource FilterButtonStyle}" Click="Filter_Click"/>
                    <Button x:Name="FilterLeave" Content="🟡 Отпуск/Больничный" Style="{StaticResource FilterButtonStyle}" Click="Filter_Click"/>
                    <Button x:Name="FilterFired" Content="🔴 Уволенные" Style="{StaticResource FilterButtonStyle}" Click="Filter_Click"/>
                </StackPanel>
                <DataGrid x:Name="WorkersGrid" Grid.Row="2" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single" SelectionChanged="WorkersGrid_SelectionChanged" HeadersVisibility="Column" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#F0F0F0" RowHeight="40" Background="Transparent" BorderThickness="0" VerticalScrollBarVisibility="Auto">
                    <DataGrid.ColumnHeaderStyle>
                        <Style TargetType="DataGridColumnHeader">
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="Foreground" Value="{StaticResource SecondaryTextBrush}"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                            <Setter Property="FontSize" Value="12"/>
                            <Setter Property="Padding" Value="12,0"/>
                            <Setter Property="BorderThickness" Value="0"/>
                        </Style>
                    </DataGrid.ColumnHeaderStyle>
                    <DataGrid.CellStyle>
                        <Style TargetType="DataGridCell">
                            <Setter Property="Padding" Value="12,0"/>
                            <Setter Property="BorderThickness" Value="0"/>
                            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
                            <Setter Property="VerticalAlignment" Value="Center"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="DataGridCell">
                                        <Grid Background="{TemplateBinding Background}">
                                            <ContentPresenter VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                                        </Grid>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </DataGrid.CellStyle>
                    <DataGrid.RowStyle>
                        <Style TargetType="DataGridRow">
                            <Setter Property="Background" Value="Transparent"/>
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#F7F6FB"/>
                                </Trigger>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter Property="Background" Value="#EDE7F6"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </DataGrid.RowStyle>
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="ID" Binding="{Binding UserId}" Width="50"/>
                        <DataGridTextColumn Header="ФИО" Binding="{Binding FullName}" Width="*" MinWidth="150"/>
                        <DataGridTextColumn Header="Логин" Binding="{Binding Username}" Width="120"/>
                        <DataGridTextColumn Header="Роль" Binding="{Binding RoleName}" Width="100"/>
                        <DataGridTextColumn Header="Статус" Binding="{Binding StatusDisplay}" Width="140"/>
                    </DataGrid.Columns>
                </DataGrid>
                <Button Grid.Row="3" Content="➕ Нанять сотрудника" HorizontalAlignment="Left" Margin="0,15,0,0" Background="{StaticResource PrimaryBrush}" Foreground="White" Click="NewWorker_Click"/>
            </Grid>
        </Border>
        <GridSplitter Grid.Column="1" Width="3" Background="Transparent" HorizontalAlignment="Center"/>
        <Border x:Name="CardPanel" Grid.Column="2" Style="{StaticResource Card}" Margin="12,0,0,0" MinWidth="320" Visibility="Collapsed">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock x:Name="CardTitle" Text="Карточка сотрудника" FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource PrimaryBrush}" Margin="0,0,0,15"/>
                    <TextBlock Text="ФИО" FontSize="12" Foreground="{StaticResource SecondaryTextBrush}" Margin="0,0,0,3"/>
                    <TextBox x:Name="NameBox" Margin="0,0,0,12"/>
                    <TextBlock Text="Логин" FontSize="12" Foreground="{StaticResource SecondaryTextBrush}" Margin="0,0,0,3"/>
                    <TextBox x:Name="LoginBox" Margin="0,0,0,12"/>
                    <TextBlock Text="Роль" FontSize="12" Foreground="{StaticResource SecondaryTextBrush}" Margin="0,0,0,3"/>
                    <ComboBox x:Name="RoleBox" DisplayMemberPath="Name" SelectedValuePath="Id" Margin="0,0,0,12"/>
                    <TextBlock Text="Статус" FontSize="12" Foreground="{StaticResource SecondaryTextBrush}" Margin="0,0,0,3"/>
                    <ComboBox x:Name="StatusBox" DisplayMemberPath="Name" SelectedValuePath="Id" Margin="0,0,0,12"/>
                    <TextBlock Text="Новый пароль (оставьте пустым, чтобы не менять)" FontSize="12" Foreground="{StaticResource SecondaryTextBrush}" Margin="0,0,0,3" TextWrapping="Wrap"/>
                    <PasswordBox x:Name="PasswordBox" Margin="0,0,0,15"/>
                    <Border Height="1" Background="{StaticResource BorderBrush}" Margin="0,0,0,12"/>
                    <StackPanel x:Name="LeaveSection">
                        <TextBlock Text="📅 Отпуска и больничные" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,8"/>
                        <ItemsControl x:Name="LeaveList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Padding="8,6" Margin="0,0,0,4" Background="{StaticResource BackgroundBrush}" CornerRadius="6">
                                        <TextBlock Text="{Binding DisplayText}" FontSize="12" TextWrapping="Wrap"/>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Button Content="➕ Добавить" HorizontalAlignment="Left" FontSize="12" Background="Transparent" Foreground="{StaticResource PrimaryBrush}" BorderThickness="0" Padding="0" Cursor="Hand" Click="ShowLeavePanel_Click"/>
                    </StackPanel>
                    <Border x:Name="AddLeavePanel" Background="{StaticResource BackgroundBrush}" CornerRadius="10" Padding="12" Margin="0,10,0,0" Visibility="Collapsed">
                        <StackPanel>
                            <TextBlock Text="Новый отпуск/больничный" FontWeight="SemiBold" FontSize="13" Margin="0,0,0,8"/>
                            <ComboBox x:Name="LeaveTypeBox" Margin="0,0,0,8">
                                <ComboBoxItem Content="🏖 Отпуск" Tag="vacation" IsSelected="True"/>
                                <ComboBoxItem Content="🏥 Больничный" Tag="sick"/>
                            </ComboBox>
                            <TextBlock Text="Начало" FontSize="11" Foreground="{StaticResource SecondaryTextBrush}"/>
                            <DatePicker x:Name="LeaveStartBox" Margin="0,0,0,6"/>
                            <TextBlock Text="Окончание" FontSize="11" Foreground="{StaticResource SecondaryTextBrush}"/>
                            <DatePicker x:Name="LeaveEndBox" Margin="0,0,0,10"/>
                            <StackPanel Orientation="Horizontal">
                                <Button Content="✓ Сохранить" Width="90" Height="30" FontSize="12" Background="{StaticResource PrimaryBrush}" Foreground="White" Click="AddLeave_Click"/>
                                <Button Content="✕ Отмена" Width="80" Height="30" FontSize="12" Margin="8,0,0,0" Background="Transparent" Foreground="{StaticResource SecondaryTextBrush}" BorderThickness="0" Click="HideLeavePanel_Click"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                    <Border Height="1" Background="{StaticResource BorderBrush}" Margin="0,15,0,15"/>
                    <StackPanel Orientation="Horizontal">
                        <Button Content="💾 Сохранить" Width="130" Height="36" Background="{StaticResource PrimaryBrush}" Foreground="White" Click="Save_Click"/>
                        <Button x:Name="ReturnButton" Content="🔄 К работе" Width="120" Height="36" Margin="8,0,0,0" Background="#2E7D32" Foreground="White" Click="ReturnToWork_Click"/>
                        <Button x:Name="FireButton" Content="❌ Уволить" Width="100" Height="36" Margin="8,0,0,0" Background="Transparent" Foreground="#C62828" BorderBrush="#C62828" BorderThickness="1" Click="Fire_Click"/>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Border>
        <TextBlock x:Name="EmptyPlaceholder" Grid.Column="2" Text="← Выберите сотрудника из списка" FontSize="14" Foreground="{StaticResource SecondaryTextBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="20,0,0,0"/>
    </Grid>
</Window>