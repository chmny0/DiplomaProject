<Window x:Class="WpfPlannerApp.Windows.ViewDayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Выезды за день"
        Width="600"
        Height="700"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
    </Window.Resources>

    <Grid Background="{StaticResource BackgroundBrush}"
          Margin="20">

        <Border Style="{StaticResource Card}">
            <Grid>

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0"
                            Margin="0,0,0,15">

                    <TextBlock x:Name="DayTitle"
                               FontSize="24"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource PrimaryBrush}"/>

                    <TextBlock x:Name="CountText"
                               FontSize="13"
                               Foreground="{StaticResource SecondaryTextBrush}"
                               Margin="0,4,0,0"/>
                </StackPanel>

                <ScrollViewer Grid.Row="1"
                              VerticalScrollBarVisibility="Auto">

                    <ItemsControl x:Name="List">

                        <ItemsControl.ItemTemplate>
                            <DataTemplate>

                                <Border Margin="0,0,0,10"
                                        Padding="14"
                                        Background="{StaticResource SurfaceBrush}"
                                        CornerRadius="10"
                                        BorderBrush="{StaticResource BorderBrush}"
                                        BorderThickness="1"
                                        Cursor="Hand"
                                        MouseDown="Item_MouseDown">

                                    <Grid>

                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="4"/>
                                            <ColumnDefinition Width="12"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <Border Grid.Column="0"
                                                CornerRadius="2"
                                                Background="{Binding StatusColor}"/>

                                        <StackPanel Grid.Column="2">

                                            <WrapPanel>

                                                <TextBlock Text="{Binding Time}"
                                                           FontWeight="Bold"
                                                           FontSize="16"
                                                           Foreground="{StaticResource PrimaryBrush}"/>

                                                <TextBlock Text=" • "
                                                           Foreground="{StaticResource SecondaryTextBrush}"
                                                           Margin="6,0"/>

                                                <TextBlock Text="{Binding Status}"
                                                           FontWeight="SemiBold"
                                                           FontSize="14"
                                                           Foreground="{StaticResource TextBrush}"/>

                                            </WrapPanel>

                                            <TextBlock Text="{Binding Address}"
                                                       Margin="0,6,0,0"
                                                       TextWrapping="Wrap"
                                                       FontSize="13"
                                                       Foreground="{StaticResource TextBrush}"/>

                                            <TextBlock Text="{Binding WorkType}"
                                                       Margin="0,4,0,0"
                                                       FontSize="12"
                                                       Foreground="{StaticResource SecondaryTextBrush}"/>

                                            <TextBlock Text="{Binding Notes}"
                                                       Margin="0,6,0,0"
                                                       FontSize="12"
                                                       Foreground="{StaticResource SecondaryTextBrush}"
                                                       FontStyle="Italic"
                                                       TextWrapping="Wrap"
                                                       Visibility="{Binding HasNotes, Converter={StaticResource BoolToVisibilityConverter}}"/>

                                            <TextBlock Text="{Binding Workers}"
                                                       Margin="0,6,0,0"
                                                       FontSize="11"
                                                       Foreground="{StaticResource SecondaryTextBrush}"/>

                                        </StackPanel>

                                    </Grid>

                                </Border>

                            </DataTemplate>
                        </ItemsControl.ItemTemplate>

                    </ItemsControl>

                </ScrollViewer>

            </Grid>
        </Border>

    </Grid>
</Window>