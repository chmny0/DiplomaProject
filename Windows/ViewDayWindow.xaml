<Window x:Class="WpfPlannerApp.Windows.ViewDayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Выезды за день"
        Width="540"
        Height="640"
        WindowStartupLocation="CenterScreen">

    <Grid Background="{StaticResource BgBrush}">
        <Border Margin="20"
                Background="White"
                CornerRadius="18"
                Padding="20">

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Margin="0,0,0,12">
                    <TextBlock x:Name="DayTitle"
                               FontSize="26"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource PrimaryBrush}"/>

                    <Button Content="➕ Добавить выезд"
                            Margin="0,10,0,0"
                            Background="{StaticResource AccentBrush}"
                            Click="Add_Click"/>
                </StackPanel>

                <ScrollViewer Grid.Row="1">
                    <ItemsControl x:Name="List">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Margin="0,0,0,10"
                                        Padding="14"
                                        Background="White"
                                        CornerRadius="12"
                                        BorderBrush="{StaticResource BorderBrush}"
                                        BorderThickness="1"
                                        Cursor="Hand"
                                        MouseDown="Item_MouseDown">
                                    <StackPanel>
                                        <WrapPanel>
                                            <TextBlock Text="{Binding Time}"
                                                       FontWeight="Bold"
                                                       FontSize="16"
                                                       Foreground="{StaticResource PrimaryBrush}"/>
                                            <TextBlock Text=" • " Foreground="#999" Margin="5,0"/>
                                            <TextBlock Text="{Binding Status}" FontWeight="SemiBold"/>
                                        </WrapPanel>

                                        <TextBlock Text="{Binding Address}" Margin="0,4,0,0" TextWrapping="Wrap"/>
                                        <TextBlock Text="{Binding WorkType}" Margin="0,2,0,0" FontSize="12" Foreground="#666"/>
                                        <TextBlock Text="Кликните для редактирования"
                                                   Margin="0,6,0,0"
                                                   FontSize="11"
                                                   Foreground="#888"
                                                   FontStyle="Italic"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Border>
    </Grid>
</Window>
