<Window x:Class="WpfPlannerApp.Windows.EditAppointmentWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Наряд"
        Width="550"
        Height="780"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="{StaticResource BackgroundBrush}">

    <Grid>
        <Border Style="{StaticResource Card}">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>

                    <TextBlock x:Name="TitleText"
                               Text="✏ Наряд"
                               FontSize="22"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource PrimaryBrush}"
                               Margin="0,0,0,15"/>

                    <TextBlock Text="Клиент"
                               FontSize="12"
                               Foreground="{StaticResource SecondaryTextBrush}"
                               Margin="0,0,0,3"/>
                    <TextBox x:Name="ClientBox"
                             IsReadOnly="True"
                             Background="{StaticResource BackgroundBrush}"
                             Margin="0,0,0,5"/>

                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Телефон"
                                       FontSize="11"
                                       Foreground="{StaticResource SecondaryTextBrush}"
                                       Margin="0,0,0,2"/>
                            <TextBox x:Name="PhoneBox"
                                     IsReadOnly="True"
                                     Background="{StaticResource BackgroundBrush}"
                                     FontSize="12"/>
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Email"
                                       FontSize="11"
                                       Foreground="{StaticResource SecondaryTextBrush}"
                                       Margin="0,0,0,2"/>
                            <TextBox x:Name="EmailBox"
                                     IsReadOnly="True"
                                     Background="{StaticResource BackgroundBrush}"
                                     FontSize="12"/>
                        </StackPanel>
                    </Grid>

                    <Border x:Name="ContractSection"
                            Background="#FFF8E1"
                            CornerRadius="6"
                            Padding="10"
                            Margin="0,0,0,10"
                            Visibility="Collapsed">
                        <StackPanel>
                            <TextBlock Text="📄 Договор"
                                       FontWeight="SemiBold"
                                       FontSize="13"
                                       Foreground="#E65100"/>
                            <TextBlock x:Name="ContractInfoText"
                                       FontSize="12"
                                       Foreground="{StaticResource TextBrush}"
                                       TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>

                    <TextBlock Text="Тип услуги"
                               FontSize="12"
                               Foreground="{StaticResource SecondaryTextBrush}"
                               Margin="0,0,0,3"/>
                    <ComboBox x:Name="WorkTypeBox"
                              DisplayMemberPath="Name"
                              SelectedValuePath="Id"
                              Margin="0,0,0,10"/>

                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="120"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Дата"
                                       FontSize="12"
                                       Foreground="{StaticResource SecondaryTextBrush}"
                                       Margin="0,0,0,3"/>
                            <DatePicker x:Name="DateBox"/>
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Время"
                                       FontSize="12"
                                       Foreground="{StaticResource SecondaryTextBrush}"
                                       Margin="0,0,0,3"/>
                            <TextBox x:Name="TimeBox"/>
                        </StackPanel>
                    </Grid>

                    <TextBlock Text="Адрес"
                               FontSize="12"
                               Foreground="{StaticResource SecondaryTextBrush}"
                               Margin="0,0,0,3"/>
                    <TextBox x:Name="AddressBox"
                             Margin="0,0,0,10"/>

                    <TextBlock Text="Описание работ"
                               FontSize="12"
                               Foreground="{StaticResource SecondaryTextBrush}"
                               Margin="0,0,0,3"/>
                    <TextBox x:Name="NotesBox"
                             Height="70"
                             AcceptsReturn="True"
                             TextWrapping="Wrap"
                             Margin="0,0,0,10"/>

                    <TextBlock Text="Статус"
                               FontSize="12"
                               Foreground="{StaticResource SecondaryTextBrush}"
                               Margin="0,0,0,3"/>
                    <ComboBox x:Name="StatusBox"
                              DisplayMemberPath="Name"
                              SelectedValuePath="Id"
                              Margin="0,0,0,10"
                              SelectionChanged="StatusBox_SelectionChanged"/>

                    <TextBlock Text="Бригада"
                               FontSize="12"
                               Foreground="{StaticResource SecondaryTextBrush}"
                               Margin="0,0,0,3"/>
                    <ListBox x:Name="WorkersList"
                             Height="120"
                             SelectionMode="Multiple"
                             DisplayMemberPath="FullName"
                             Margin="0,0,0,5"/>

                    <Border Height="1"
                            Background="{StaticResource BorderBrush}"
                            Margin="0,10,0,10"/>

                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Text="📄 Документы"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource TextBrush}"
                                   VerticalAlignment="Center"/>

                        <Button Grid.Column="1"
                                x:Name="UploadDocButton"
                                Content="📎 Загрузить"
                                Width="110"
                                Height="28"
                                FontSize="11"
                                Style="{StaticResource PrimaryButton}"
                                Click="UploadDoc_Click"/>
                    </Grid>

                    <ItemsControl x:Name="DocumentsList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="10,8"
                                        Margin="0,0,0,5"
                                        Background="{StaticResource BackgroundBrush}"
                                        CornerRadius="6">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Text="{Binding DisplayText}"
                                                   VerticalAlignment="Center"
                                                   FontSize="12"
                                                   Foreground="{StaticResource TextBrush}"
                                                   TextWrapping="Wrap"/>

                                        <Button Grid.Column="1"
                                                Content="👁"
                                                Width="36"
                                                Height="28"
                                                Tag="{Binding DocumentId}"
                                                Click="ViewDocument_Click"
                                                Background="Transparent"
                                                BorderThickness="0"
                                                Cursor="Hand"
                                                FontSize="14"
                                                ToolTip="Открыть файл"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <Button x:Name="AddActButton"
                            Content="➕ Создать акт выполненных работ"
                            Visibility="Collapsed"
                            Margin="0,5,0,10"
                            Style="{StaticResource PrimaryButton}"
                            FontSize="13"
                            Click="AddAct_Click"/>

                    <Border Height="1"
                            Background="{StaticResource BorderBrush}"
                            Margin="0,5,0,15"/>

                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Right">

                        <Button Content="Отмена"
                                Width="100"
                                Height="36"
                                Background="Transparent"
                                Foreground="{StaticResource SecondaryTextBrush}"
                                BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="1"
                                Click="Cancel_Click"/>

                        <Button Content="💾 Сохранить"
                                Width="130"
                                Height="36"
                                Margin="10,0,0,0"
                                Style="{StaticResource AccentButton}"
                                Click="Save_Click"/>

                    </StackPanel>

                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</Window>