<UserControl x:Class="WpfPlannerApp.Windows.RequestsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Background="{StaticResource BackgroundBrush}"
          Margin="20">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Style="{StaticResource Card}"
                Margin="0,0,0,15">

            <StackPanel Orientation="Horizontal">

                <ComboBox x:Name="ClientTypeFilter"
                          Width="150"
                          Margin="0,0,10,0"
                          SelectionChanged="Filter_Changed"/>

                <ComboBox x:Name="WorkTypeFilter"
                          Width="180"
                          Margin="0,0,10,0"
                          SelectionChanged="Filter_Changed"/>

                <DatePicker x:Name="DateFrom"
                            Width="150"
                            Margin="0,0,10,0"
                            SelectedDateChanged="Filter_Changed"/>

                <DatePicker x:Name="DateTo"
                            Width="150"
                            Margin="0,0,10,0"
                            SelectedDateChanged="Filter_Changed"/>

                <Button Content="Сброс"
                        Style="{StaticResource PrimaryButton}"
                        Click="Reset_Click"/>

            </StackPanel>

        </Border>

        <ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">

            <ItemsControl x:Name="List">

                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>

                <ItemsControl.ItemTemplate>
                    <DataTemplate>

                        <Border Width="300"
                                Margin="0,0,15,15"
                                Padding="15"
                                Background="{StaticResource SurfaceBrush}"
                                CornerRadius="12"
                                BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="1"
                                Cursor="Hand"
                                MouseDown="Card_Click">

                            <StackPanel>

                                <TextBlock Text="{Binding Client}"
                                           FontWeight="SemiBold"
                                           FontSize="16"
                                           Foreground="{StaticResource TextBrush}"
                                           TextWrapping="Wrap"/>

                                <TextBlock Text="{Binding Phone}"
                                           FontSize="12"
                                           Foreground="{StaticResource SecondaryTextBrush}"
                                           Margin="0,4,0,0"/>

                                <TextBlock Text="{Binding WorkType}"
                                           FontSize="13"
                                           Foreground="{StaticResource TextBrush}"
                                           Margin="0,8,0,0"
                                           TextWrapping="Wrap"/>

                                <TextBlock Text="{Binding Date}"
                                           FontSize="12"
                                           Foreground="{StaticResource SecondaryTextBrush}"
                                           Margin="0,4,0,0"/>

                                <TextBlock Text="{Binding Status}"
                                           FontSize="12"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource PrimaryBrush}"
                                           Margin="0,6,0,0"/>

                                <Button Content="📅 Создать выезд"
                                        Margin="0,12,0,0"
                                        Tag="{Binding Id}"
                                        Style="{StaticResource AccentButton}"
                                        Click="CreateAppointment_Click"/>

                            </StackPanel>

                        </Border>

                    </DataTemplate>
                </ItemsControl.ItemTemplate>

            </ItemsControl>

        </ScrollViewer>

    </Grid>

</UserControl>