<Window x:Class="WpfPlannerApp.Windows.AddAppointmentWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Создание наряда"
        Width="520"
        Height="800"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize">

    <Grid Background="{StaticResource BackgroundBrush}"
          Margin="20">

        <Border Style="{StaticResource Card}">
            <ScrollViewer VerticalScrollBarVisibility="Auto">

                <StackPanel>

                    <TextBlock Text="📋 Создание наряда"
                               FontSize="22"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource PrimaryBrush}"
                               Margin="0,0,0,5"/>

                    <TextBlock x:Name="SubtitleText"
                               Text="на основе заявки №..."
                               FontSize="13"
                               Foreground="{StaticResource SecondaryTextBrush}"
                               Margin="0,0,0,15"/>

                    <TextBlock Text="Клиент"
                               FontSize="12"
                               Foreground="{StaticResource SecondaryTextBrush}"
                               Margin="0,0,0,3"/>

                    <TextBox x:Name="ClientBox"
                             IsReadOnly="True"
                             Background="{StaticResource BackgroundBrush}"
                             Margin="0,0,0,10"/>

                    <Border x:Name="ContractSection"
                            Background="#FFF8E1"
                            CornerRadius="8"
                            Padding="10"
                            Margin="0,0,0,10"
                            Visibility="Collapsed">

                        <StackPanel>

                            <TextBlock Text="📄 Договор"
                                       FontWeight="SemiBold"
                                       FontSize="13"
                                       Foreground="#E65100"
                                       Margin="0,0,0,3"/>

                            <TextBlock x:Name="ContractInfoText"
                                       FontSize="12"
                                       Foreground="{StaticResource TextBrush}"
                                       TextWrapping="Wrap"/>

                            <TextBlock x:Name="ContractWarningText"
                                       Text="⚠ Внимание: активный договор не найден"
                                       FontSize="11"
                                       Foreground="#C62828"
                                       Margin="0,4,0,0"
                                       Visibility="Collapsed"/>

                            <Button x:Name="GenerateContractButton"
                                    Content="📄 Сгенерировать договор"
                                    HorizontalAlignment="Left"
                                    Margin="0,8,0,0"
                                    Background="#E65100"
                                    Foreground="White"
                                    FontSize="12"
                                    FontWeight="SemiBold"
                                    Padding="14,6"
                                    Cursor="Hand"
                                    Click="GenerateContract_Click"
                                    Visibility="Collapsed"/>

                            <TextBlock x:Name="GeneratedContractText"
                                       FontSize="12"
                                       Foreground="{StaticResource TextBrush}"
                                       TextWrapping="Wrap"
                                       Margin="0,6,0,0"
                                       Visibility="Collapsed"/>

                        </StackPanel>
                    </Border>

                    <TextBlock Text="Тип услуги"
                               FontSize="12"
                               Foreground="{StaticResource SecondaryTextBrush}"
                               Margin="0,0,0,3"/>

                    <ComboBox x:Name="WorkTypeBox"
                              DisplayMemberPath="Name"
                              SelectedValuePath="Id"
                              Margin="0,0,0,10"/>

                    <Grid Margin="0,0,0,10">

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="120"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">

                            <TextBlock Text="Дата выезда"
                                       FontSize="12"
                                       Foreground="{StaticResource SecondaryTextBrush}"
                                       Margin="0,0,0,3"/>

                            <DatePicker x:Name="DateBox"/>

                        </StackPanel>

                        <StackPanel Grid.Column="2">

                            <TextBlock Text="Время"
                                       FontSize="12"
                                       Foreground="{StaticResource SecondaryTextBrush}"
                                       Margin="0,0,0,3"/>

                            <TextBox x:Name="TimeBox"
                                     Text="10:00"/>

                        </StackPanel>

                    </Grid>

                    <TextBlock Text="Адрес выезда"
                               FontSize="12"
                               Foreground="{StaticResource SecondaryTextBrush}"
                               Margin="0,0,0,3"/>

                    <TextBox x:Name="AddressBox"
                             Margin="0,0,0,10"/>

                    <TextBlock Text="Описание работ"
                               FontSize="12"
                               Foreground="{StaticResource SecondaryTextBrush}"
                               Margin="0,0,0,3"/>

                    <TextBox x:Name="NotesBox"
                             Height="80"
                             AcceptsReturn="True"
                             TextWrapping="Wrap"
                             Margin="0,0,0,10"/>

                    <TextBlock Text="Бригада"
                               FontSize="12"
                               Foreground="{StaticResource SecondaryTextBrush}"
                               Margin="0,0,0,3"/>

                    <ListBox x:Name="WorkersList"
                             Height="120"
                             SelectionMode="Multiple"
                             DisplayMemberPath="FullName"
                             Margin="0,0,0,5"/>

                    <Border Height="1"
                            Background="{StaticResource BorderBrush}"
                            Margin="0,10,0,10"/>

                    <TextBlock Text="📄 Документы"
                               FontSize="14"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource TextBrush}"
                               Margin="0,0,0,8"/>

                    <Button x:Name="UploadDocButton"
                            Content="📎 Прикрепить документ"
                            HorizontalAlignment="Left"
                            Margin="0,0,0,10"
                            Style="{StaticResource AccentButton}"
                            Click="UploadDoc_Click"/>

                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Right"
                                Margin="0,10,0,0">

                        <Button Content="Отмена"
                                Width="100"
                                Style="{StaticResource PrimaryButton}"
                                Background="Transparent"
                                Foreground="{StaticResource SecondaryTextBrush}"
                                BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="1"
                                Click="Cancel_Click"/>

                        <Button Content="✅ Создать наряд"
                                Width="150"
                                Margin="10,0,0,0"
                                Style="{StaticResource AccentButton}"
                                Click="Save_Click"/>

                    </StackPanel>

                </StackPanel>

            </ScrollViewer>
        </Border>

    </Grid>
</Window>