<Window x:Class="WpfPlannerApp.Windows.AddAppointmentWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Создать выезд"
        Width="440"
        Height="620"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize">

    <!-- Фон -->
    <Grid>
        <Grid.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#FFF1E6" Offset="0"/>
                <GradientStop Color="#F3EDFB" Offset="1"/>
            </LinearGradientBrush>
        </Grid.Background>

        <!-- Карточка -->
        <Border Margin="20"
                Background="White"
                CornerRadius="18"
                Padding="20">

            <ScrollViewer VerticalScrollBarVisibility="Auto">

                <StackPanel>

                    <!-- Заголовок -->
                    <TextBlock Text="Создать выезд"
                               FontSize="26"
                               FontWeight="SemiBold"
                               FontFamily="Segoe UI Variable"
                               Foreground="#560EAD"/>

                    <TextBlock Text="Запланируйте новый выезд специалистов"
                               Margin="0,4,0,20"
                               Foreground="#666"/>

                    <!-- Дата -->
                    <TextBlock Text="Дата"/>
                    <DatePicker x:Name="DateBox"
                                Height="36"
                                Margin="0,6,0,12"/>

                    <!-- Время -->
                    <TextBlock Text="Время (ЧЧ:мм)"/>
                    <TextBox x:Name="TimeBox"
         Height="36"
         PreviewTextInput="TimeBox_PreviewTextInput"
         TextChanged="TimeBox_TextChanged"
         Text="10:00"/>


                    <!-- Адрес -->
                    <TextBlock Text="Адрес"/>
                    <TextBox x:Name="AddressBox"
                             Height="36"
                             Margin="0,6,0,12"/>

                    <!-- Тип работ -->
                    <TextBlock Text="Тип работ"/>
                    <ComboBox x:Name="WorkTypeBox"
                              Height="36"
                              Margin="0,6,0,12"
                              DisplayMemberPath="type_name"
                              SelectedValuePath="type_id"/>

                    <!-- Работники -->
                    <TextBlock Text="Работники"/>
                    <Border BorderBrush="#E5E5E5" 
                            BorderThickness="1" 
                            CornerRadius="8"
                            Background="#FAFAFA"
                            Height="120"
                            Margin="0,6,0,12"
                            Padding="4">
                        <ListBox x:Name="WorkersList"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 SelectionMode="Multiple"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                                 DisplayMemberPath="full_name">
                        </ListBox>
                    </Border>

                    <!-- Примечание -->
                    <TextBlock Text="Примечание"/>
                    <TextBox x:Name="NotesBox"
                             Height="90"
                             AcceptsReturn="True"
                             TextWrapping="Wrap"
                             Margin="0,6,0,20"/>

                    <!-- Кнопка -->
                    <Button Content="Сохранить выезд"
                            Height="42"
                            FontSize="15"
                            Background="#FF7400"
                            Foreground="White"
                            FontWeight="SemiBold"
                            Click="Save_Click"/>

                </StackPanel>

            </ScrollViewer>
        </Border>
    </Grid>
</Window>