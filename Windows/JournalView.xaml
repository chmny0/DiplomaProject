<UserControl x:Class="WpfPlannerApp.Windows.JournalView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Background="{StaticResource BackgroundBrush}" Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="📊 Журналы"
                   FontSize="20"
                   FontWeight="SemiBold"
                   Foreground="{StaticResource PrimaryBrush}"
                   Margin="0,0,0,10"/>

        <TabControl x:Name="JournalTabs"
                    Grid.Row="1"
                    SelectionChanged="JournalTabs_SelectionChanged"
                    Margin="0,0,0,10"
                    Background="Transparent"
                    BorderThickness="0">

            <TabControl.Resources>
                <Style TargetType="TabItem">
                    <Setter Property="FontSize" Value="13"/>
                    <Setter Property="FontWeight" Value="SemiBold"/>
                    <Setter Property="Padding" Value="14,8"/>
                    <Setter Property="Background" Value="Transparent"/>
                    <Setter Property="Foreground" Value="{StaticResource SecondaryTextBrush}"/>
                    <Setter Property="BorderThickness" Value="0"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="TabItem">
                                <Border Background="{TemplateBinding Background}"
                                        Padding="{TemplateBinding Padding}"
                                        CornerRadius="8"
                                        Margin="0,0,4,0">
                                    <ContentPresenter
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Content="{TemplateBinding Header}"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter Property="Background" Value="{StaticResource PrimaryBrush}"/>
                                        <Setter Property="Foreground" Value="White"/>
                                    </Trigger>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="{StaticResource PrimaryBrush}"/>
                                        <Setter Property="Foreground" Value="White"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </TabControl.Resources>

            <TabItem Header="📋 Заявки"/>
            <TabItem Header="📅 Наряды"/>
            <TabItem Header="📄 Документы"/>
        </TabControl>

        <StackPanel x:Name="FiltersPanel"
                    Grid.Row="2"
                    Orientation="Horizontal"
                    Margin="0,0,0,10"
                    Visibility="Collapsed">

            <ComboBox x:Name="StatusFilter"
                      Width="180"
                      Margin="0,0,10,0"
                      VerticalAlignment="Center"
                      SelectionChanged="Filter_Changed"/>

            <ComboBox x:Name="WorkTypeFilter"
                      Width="180"
                      Margin="0,0,10,0"
                      VerticalAlignment="Center"
                      SelectionChanged="Filter_Changed"/>

            <ComboBox x:Name="ClientTypeFilter"
                      Width="150"
                      Margin="0,0,10,0"
                      VerticalAlignment="Center"
                      SelectionChanged="Filter_Changed"/>

            <DatePicker x:Name="DateFrom"
                        Width="150"
                        Margin="0,0,10,0"
                        VerticalAlignment="Center"
                        SelectedDateChanged="Filter_Changed"/>

            <DatePicker x:Name="DateTo"
                        Width="150"
                        Margin="0,0,10,0"
                        VerticalAlignment="Center"
                        SelectedDateChanged="Filter_Changed"/>

            <Button Content="Сброс"
                    VerticalAlignment="Center"
                    Style="{StaticResource PrimaryButton}"
                    Click="ResetFilters_Click"
                    Margin="0,0,10,0"/>

            <Button Content="📥 Выгрузить в Excel"
                    VerticalAlignment="Center"
                    Style="{StaticResource AccentButton}"
                    Click="ExportToExcel_Click"/>
        </StackPanel>

        <ScrollViewer Grid.Row="3"
                      VerticalScrollBarVisibility="Auto">

            <ItemsControl x:Name="CardsList">

                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>

                <ItemsControl.ItemTemplate>
                    <DataTemplate>

                        <Border Width="280"
                                Margin="8"
                                Padding="14"
                                Background="{StaticResource SurfaceBrush}"
                                CornerRadius="12"
                                BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="1"
                                Cursor="Hand"
                                MouseDown="Card_Click">

                            <StackPanel>

                                <TextBlock Text="{Binding Title}"
                                           FontWeight="Bold"
                                           FontSize="15"
                                           TextWrapping="Wrap"
                                           Foreground="{StaticResource TextBrush}"/>

                                <TextBlock Text="{Binding Subtitle}"
                                           FontSize="12"
                                           Foreground="{StaticResource SecondaryTextBrush}"
                                           Margin="0,4,0,0"
                                           TextWrapping="Wrap"/>

                                <TextBlock Text="{Binding Date}"
                                           FontSize="12"
                                           Foreground="{StaticResource SecondaryTextBrush}"
                                           Margin="0,4,0,0"/>

                                <TextBlock Text="{Binding Status}"
                                           FontSize="12"
                                           FontWeight="SemiBold"
                                           Foreground="{Binding StatusColor}"
                                           Margin="0,6,0,0"/>

                            </StackPanel>
                        </Border>

                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</UserControl>